; El porcentaje de cobertura controla la opacidad del volumen nuboso.
[FileFormat]
met3dVersion=2.0.0b11/Oct26

[MActor]
actorName=Cobertura nubosa [%]
properties\actor_enabled=true
properties\clamp_hcl_colours=true
properties\colourmap_type=1
properties\extend_above_max=true
properties\extend_below_min=false
properties\label_properties\display_description=Cobertura nubosa [%]
properties\label_properties\label_value_scaling=1
properties\label_properties\labels_enabled=true
properties\label_properties\label_colour={{ scene.appearance.text_colour_variant }}
properties\label_properties\bounding_box=true
properties\label_properties\bbox_colour={{ scene.appearance.label_background_colour_variant }}
properties\label_properties\label_size=20
properties\label_properties\number_of_tick_labels=5
properties\label_properties\number_of_tick_marks=5
properties\max_value={{ cloud_cover.maximum_percent }}
properties\min_value={{ cloud_cover.minimum_percent }}
properties\opacity_enabled=true
properties\orientation=0
properties\reverse_range_enabled=false
properties\steps={{ cloud_cover.colour_steps }}
properties\viewport_position_and_size={{ cloud_cover.colourbar_rectangle }}
properties\wire_frame_enabled=false

[Metadata]
actorConfigType=Transfer function scalar to colour (colour map)

[TransferFunction1D]
colourNode\size=2
colourNode\1\position=0
colourNode\1\colour={{ cloud_cover.colour_xyz }}
colourNode\2\position=1
colourNode\2\colour={{ cloud_cover.colour_xyz }}
alphaNode\size=2
alphaNode\1\position=0
alphaNode\1\alpha=0
alphaNode\2\position=1
alphaNode\2\alpha={{ cloud_cover.maximum_opacity }}
colourSpaceForColourNodeInterpolation=rgb
