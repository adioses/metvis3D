; Render temporal en Met.3D. Los fotogramas se codifican después con FFmpeg.
[BatchMode]
animation_type={% if camera_sequence %}cameraSequenceTimeAnimation{% else %}timeAnimation{% endif %}
{% if camera_sequence %}camera_sequence_file={{ camera_sequence.resolve() }}
{% endif %}
synchronization_name=Valid time
session_file={{ session_file }}
start_at_most_recent_init_time_of_datasource={{ dataset_name }}
animation_time_range_s={{ timeline.range_seconds }}
animation_time_step={{ timeline.step_seconds }} seconds
screenshot_directory={{ frames_directory }}
screenshot_filename=frame-%fn{% if camera_sequence %}-%t{% endif %}
screenshot_file_extension=.png
overwrite_existing_image_files=true
quit_when_completed=true
