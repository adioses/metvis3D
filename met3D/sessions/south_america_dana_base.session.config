[FileFormat]
met3dVersion=2.0.0b11/Oct26

[MSession]
; Animación temporal. El batch sustituye save_images y saved_views en su copia runtime.
Animation\advance_interval=1
Animation\advance_type=1
Animation\cam_loop_type=0
Animation\cam_runtime_seconds=10
Animation\delay_ms=1000
Animation\enable_camera_animation=false
Animation\enable_time_animation=true
Animation\from_time=@DateTime(\0\0\0\x10\0\0\0\0\0\0%\x8e_\0\0\0\0\x3\0\0\0\x1a\0O\0\x66\0\x66\0s\0\x65\0t\0\x46\0r\0\x6f\0m\0U\0t\0\x63\0\0\0\x6\0U\0T\0\x43\0\0\0\0\0\0\0\x6\0U\0T\0\x43\0\0\0\x6\0U\0T\0\x43\0\0\0\0\0\0\0\x6\0U\0T\0\x43)
Animation\image_extension=0
Animation\loop_type=0
Animation\name_format=%fn-met3d-image.%t.%V
Animation\open_directory_on_finish=false
Animation\reverse=false
Animation\save_directory=/home/alen/met3d/images
Animation\save_images=false
Animation\save_type=0
Animation\saved_views=@Invalid()
Animation\time_control=Valid time
Animation\time_step=6
Animation\time_step_unit=2
Animation\to_time=@DateTime(\0\0\0\x10\0\0\0\0\0\0%\x8e_\0\0\0\0\x3\0\0\0\x1a\0O\0\x66\0\x66\0s\0\x65\0t\0\x46\0r\0\x6f\0m\0U\0t\0\x63\0\0\0\x6\0U\0T\0\x43\0\0\0\0\0\0\0\x6\0U\0T\0\x43\0\0\0\x6\0U\0T\0\x43\0\0\0\0\0\0\0\x6\0U\0T\0\x43)
Animation\used_camera_sequence=-1

; Grupos estructurales requeridos por el cargador de sesiones. Las cajas se generan en runtime.
BoundingBoxes\boundingBox\size=0
CameraSequences\sequences\size=0

; Fuentes estables del NetCDF y de los diagnósticos calculados por Met.3D.
DataSources=standardized_data, standardized_data derived
EnsembleControls\1\EnsembleControl\data_sources=standardized_data, standardized_data derived
EnsembleControls\1\EnsembleControl\selected_member=0
EnsembleControls\1\EnsembleControl\show_mean=false
EnsembleControls\1\name=Ensemble
EnsembleControls\size=1

; No se guardan actores meteorológicos aquí: se cargan desde los actor.conf generados.
MActors\numActors=0

